    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
